# Website (set these in Vercel → Project → Settings → Environment Variables)
# Google Form share link for "Advertise your event".
NEXT_PUBLIC_ADVERTISE_FORM_URL=
# Google Form share link for "Report a problem". Each card's flag uses a pre-filled link
# (REPORT_PREFILLED in components/final/PageFinal.tsx) unless this contains EVENT_ID.
NEXT_PUBLIC_REPORT_FORM_URL=
# PostHog project key (a public client token) and the host the browser sends to.
# On Vercel the host is /ingest, which vercel.json forwards to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Collector (set these in GitHub → Repo → Settings → Variables → Actions)
# Google Sheet "Publish to web" CSV link of the Advertise form's responses. Rows publish only
# when their "Approved" column says yes.
PROMOTED_CSV_URL=
# Optional: same for a reports sheet; listings with 2+ reports are hidden. Unset = manual.
REPORTS_CSV_URL=
