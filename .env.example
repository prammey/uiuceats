# Website (set these in Vercel → Project → Settings → Environment Variables)
# Google Form link for "Advertise your event".
NEXT_PUBLIC_ADVERTISE_FORM_URL=
# Pre-filled Google Form link for "Report a problem"; put EVENT_ID where the event id goes.
NEXT_PUBLIC_REPORT_FORM_URL=

# Collector (set these in GitHub → Repo → Settings → Variables → Actions)
# Each is a Google Sheet "Publish to web" CSV link.
PROMOTED_CSV_URL=
REPORTS_CSV_URL=
